# ==============================================================================
# PlacidWay Medical Tourism Knowledge Assistant - Environment Configuration
# ==============================================================================

# Primary LLM Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Fallback LLM Provider: NVIDIA NIM (Optional)
# Obtain key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Persistent Database: Turso (Cloud libSQL/SQLite)
# Obtain free database at: https://turso.tech
# If left empty, the system automatically falls back to local SQLite at data/placidway.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vector Database: Qdrant
# Default is 'embedded' (persisted locally in data/qdrant). Can also be 'memory' or 'remote'.
QDRANT_MODE=embedded
QDRANT_URL=
QDRANT_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Ingestion & Politeness Settings
CRAWLER_USER_AGENT=PlacidWayAssessmentBot/1.0
CRAWLER_RATE_LIMIT_DELAY=1.0

# Knowledge Base & Retrieval Paths
DATA_DIR=data
RAW_HTML_DIR=data/raw_html
MARKDOWN_DIR=data/markdown
QDRANT_STORAGE_DIR=data/qdrant
SQLITE_DB_PATH=data/placidway.db

# Default Active Orchestration Pattern ('pattern_a', 'pattern_b', or 'pattern_c')
DEFAULT_ORCHESTRATION_PATTERN=pattern_b
